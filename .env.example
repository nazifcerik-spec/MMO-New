# Copy to .env (never commit .env). Used by docker compose and the backend.
POSTGRES_USER=mmo
POSTGRES_PASSWORD=mmo
POSTGRES_DB=mmo
MMO_ENV=dev
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
MMO_SECRET_KEY=change-me
MMO_CORS_ORIGINS=["http://localhost:3000"]
MMO_LOG_LEVEL=INFO
